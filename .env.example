PORT=3000
NODE_ENV=development

# Mongo local:
# MONGO_URL=mongodb://localhost:27017/eventos
# MongoDB Atlas (reemplazar usuario, password y el host del cluster por los tuyos;
# el nombre de la base, "eventos", va en el path antes del "?"):
MONGO_URL=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/eventos?retryWrites=true&w=majority

JWT_SECRET=reemplazar_por_un_secreto_seguro
# Tiempo de expiración del JWT (formato aceptado por la librería jsonwebtoken: "1h", "30m", "7d", etc.)
JWT_EXPIRES_IN=1h

# Envío de emails (Nodemailer) — se usa para el email de confirmación al
# inscribirse a un evento. Nunca hardcodear estas credenciales en el código.
#
# Opción recomendada para desarrollo/pruebas: Ethereal (https://ethereal.email/create),
# un SMTP falso y gratuito pensado justo para esto — no entrega emails reales,
# pero los "recibe" y te da un link para verlos, así no hace falta una cuenta
# de email real para probar el flujo completo:
# MAIL_HOST=smtp.ethereal.email
# MAIL_PORT=587
# MAIL_USER=el_usuario_que_te_da_ethereal
# MAIL_PASS=la_password_que_te_da_ethereal
# MAIL_FROM=el_mismo_usuario_que_te_da_ethereal
#
# Alternativa con Gmail (requiere una "contraseña de aplicación", no la
# contraseña normal de la cuenta — se genera en la configuración de
# seguridad de la cuenta de Google):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=tu_email@gmail.com
# MAIL_PASS=la_contraseña_de_aplicación
# MAIL_FROM=tu_email@gmail.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
